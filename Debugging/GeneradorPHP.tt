<#@ template inherits="Microsoft.VisualStudio.TextTemplating.VSHost.ModelingTextTransformation" language="C#" hostspecific="True" #>
<#@ output extension=".php" #>
<#@ JCJAPGDRCDERAWebBD processor="JCJAPGDRCDERAWebBDDirectiveProcessor" requires="fileName='Sample.JCJAPGDRC_DSLDERAWebBD'" #>
<#@ include file="EF.utility.CS.ttinclude" #>
<#
// -----------------------------------------------------------------------------------------
// 1. CONFIGURACIÓN INICIAL
// -----------------------------------------------------------------------------------------
var fileManager = EntityFrameworkTemplateFileManager.Create(this);

var modelo = this.DERAWebBDModel;
var estiloPortal = modelo.EstiloPortal;

// --- DATOS DEL PORTAL (Globales) ---
// El PDF dice que el Portal define el FONDO y la FUENTE general.
string fondoPortal = "#ffffff";
string fuentePortal = "Arial";

if (estiloPortal != null) {
    if(!string.IsNullOrEmpty(estiloPortal.ColorFondo)) fondoPortal = estiloPortal.ColorFondo;
    // Nota: EstiloPortal hereda de Estilos, así que también puede tener propiedad 'Color' o 'Fuente'
    if(!string.IsNullOrEmpty(estiloPortal.Fuente)) fuentePortal = estiloPortal.Fuente;
}

// Este color es FIJO porque el DSL no tiene propiedad para "Color Texto Párrafo".
string colorTextoGeneral = "#333333"; 

// -----------------------------------------------------------------------------------------
// 2. GENERACIÓN POR ENTIDAD
// -----------------------------------------------------------------------------------------
foreach (Entidad entidad in modelo.Entidades)
{
    fileManager.StartNewFile(entidad.Name + ".php");
    
    // --- LÓGICA DE ESTILO DE PÁGINA (Aplica al TÍTULO según PDF Pág 8) ---
    string tituloTexto = "Gestión de " + entidad.Name;
    
    // Valores por defecto para el Título (H1)
    string h1Color = "#000000";       // Negro por defecto
    string h1Fuente = fuentePortal;   // Hereda la del portal
    string h1Align = "center";
    string h1Size = "2em";

    // Si la entidad tiene un estilo de página asociado, sobreescribimos los estilos del H1
    if (entidad.EstiloPagina != null)
    {
       // 1. COLOR DEL TÍTULO
       if (!string.IsNullOrEmpty(entidad.EstiloPagina.Color)) {
            h1Color = entidad.EstiloPagina.Color;
       }

       // 2. FUENTE DEL TÍTULO
       if (!string.IsNullOrEmpty(entidad.EstiloPagina.Fuente)) {
            h1Fuente = entidad.EstiloPagina.Fuente;
       }

       // 3. TAMAÑO DEL TÍTULO
       if (!string.IsNullOrEmpty(entidad.EstiloPagina.Tamanio)) {
            string t = entidad.EstiloPagina.Tamanio;
            int n;
            // Si es número "20", lo pasamos a "20px"
            if(int.TryParse(t, out n)) h1Size = t + "px";
            else h1Size = t;
       }

       // 4. ALINEACIÓN DEL TÍTULO
       if (entidad.EstiloPagina.Alineacion != null) {
            h1Align = entidad.EstiloPagina.Alineacion.ToString().ToLower();
       }
    }
#>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><#= tituloTexto #></title>
    <style>
        body {
            /* El FONDO lo marca el PORTAL (PDF Pág 8) */
            background-color: <#= fondoPortal #>;
            font-family: '<#= fuentePortal #>';
            color: <#= colorTextoGeneral #>; /* Color texto base fijo */
            padding: 20px;
        }
        
        h1 { 
            /* El ESTILO DE PAGINA se aplica al TITULO (PDF Pág 8) */
            color: <#= h1Color #>;
            font-family: '<#= h1Fuente #>';
            text-align: <#= h1Align #>; 
            font-size: <#= h1Size #>;
            
            border-bottom: 2px solid #ccc; 
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .formulario {
            max-width: 600px; 
            margin: 0 auto; 
            background: #fff; /* Formulario blanco para que se lea bien */
            padding: 20px;
            border-radius: 8px; 
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .campo { margin-bottom: 15px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; }
        input[type="text"], input[type="number"], select {
            width: 100%; padding: 8px; box-sizing: border-box; 
            border: 1px solid #ccc; border-radius: 4px;
        }
        button {
            background-color: #007BFF; color: white; padding: 10px 20px;
            border: none; cursor: pointer; width: 100%; border-radius: 4px; margin-top: 10px;
        }
        button:hover { background-color: #0056b3; }
        .pk-indicator { color: red; font-size: 0.8em; }
    </style>
</head>
<body>

    <h1><#= tituloTexto #></h1>

    <div class="formulario">
        <form action="<#= entidad.Name #>.php" method="POST">
            
            <# 
            foreach (AtributoEnt att in entidad.AtributoEnt)
            {
                string nombreAtt = att.Name;
                string tipoInput = "text";   
                
                var estiloCampo = att.EstiloCampo.Count > 0 ? att.EstiloCampo[0] : null;
                if (estiloCampo != null) {
                    string tipoEstilo = estiloCampo.TipoCampo.ToString(); 
                    if (tipoEstilo.Equals("Checkbox", StringComparison.OrdinalIgnoreCase)) tipoInput = "checkbox";
                    else if (tipoEstilo.Equals("Radio", StringComparison.OrdinalIgnoreCase)) tipoInput = "radio";
                    else if (tipoEstilo.Equals("ListaDesplegable", StringComparison.OrdinalIgnoreCase)) tipoInput = "select";
                }

                bool esEnum = false;
                string[] valoresEnum = new string[]{};
                if (att.Restriccion is RestriccionEnum) {
                    tipoInput = "select"; 
                    esEnum = true;
                    RestriccionEnum re = (RestriccionEnum)att.Restriccion;
                    if(!string.IsNullOrEmpty(re.Valores)) valoresEnum = re.Valores.Split(',');
                }
            #>

            <div class="campo">
                <label for="<#= nombreAtt #>">
                    <#= nombreAtt #> <# if(att.keyAtr) { #><span class="pk-indicator">(*PK)</span><# } #>:
                </label>
                
                <# if (tipoInput == "select") { #>
                    <select name="<#= nombreAtt #>" id="<#= nombreAtt #>">
                        <# if(esEnum && valoresEnum.Length > 0) { 
                             foreach(string v in valoresEnum) { #>
                                <option value="<#= v.Trim() #>"><#= v.Trim() #></option>
                        <#   } 
                           } else { #>
                                <option value="">Seleccione...</option>
                        <# } #>
                    </select>

                <# } else if (tipoInput == "radio") { #>
                    <div style="margin-top:5px;">
                        <label style="display:inline; font-weight:normal;"><input type="radio" name="<#= nombreAtt #>" value="1"> Sí</label>
                        <label style="display:inline; font-weight:normal; margin-left:15px;"><input type="radio" name="<#= nombreAtt #>" value="0"> No</label>
                    </div>

                <# } else if (tipoInput == "checkbox") { #>
                     <input type="checkbox" name="<#= nombreAtt #>" id="<#= nombreAtt #>" value="1">

                <# } else { #>
                    <input type="<#= tipoInput #>" name="<#= nombreAtt #>" id="<#= nombreAtt #>" <#= att.keyAtr ? "required" : "" #>>
                <# } #>
            </div>

            <# } #>

            <button type="submit" name="enviar">Guardar</button>
        </form>
    </div>

    <!-- LOGICA PHP -->
    <?php
    if(isset($_POST['enviar'])) {
        $conn = new mysqli("localhost", "root", "", "<#= this.DERAWebBDModel.Name #>");
        if ($conn->connect_error) { die("Error: " . $conn->connect_error); }

        $sql = "INSERT INTO <#= entidad.Name #> VALUES (";
        <# int c=0; foreach(AtributoEnt a in entidad.AtributoEnt){ 
             if(c>0){#> $sql .= ", "; <#}#>
             $val = isset($_POST['<#= a.Name #>']) ? $_POST['<#= a.Name #>'] : '';
             $sql .= "'" . $conn->real_escape_string($val) . "'";
             <# c++; } #>
        $sql .= ")";

        if ($conn->query($sql) === TRUE) echo "<script>alert('Guardado');</script>";
        else echo "<p>Error: " . $conn->error . "</p>";
        $conn->close();
    }
    ?>

</body>
</html>
<#
} 
fileManager.Process();
#>